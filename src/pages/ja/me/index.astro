---
import { getCollection } from "astro:content";
import PublishedBooks from "../../../components/PublishedBooks.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BULL, LINKS, bullContactFormUrl } from "../../../lib/constants";
import { bullPath, portfolioAlternates, portfolioPath } from "../../../lib/i18n";
import {
  EVIDENCE,
  EXPERIENCE_GROUPS,
  OUTCOMES,
  PROFILE,
  SPEAKING_THEMES,
  contactPaths,
} from "../../../lib/profile";
import { bullGraph, tenkaCloudSchema } from "../../../lib/seo";

const lang = "ja" as const;

const contactFormUrl = bullContactFormUrl(lang);

const posts = await getCollection("blog");
const recentPosts = posts
  .sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "short", day: "numeric" }).format(date);

const tenkaCloudAudience = [
  { label: "CCoE", detail: "社内のクラウド活用を推進するチーム" },
  { label: "SRE / Platform チーム", detail: "障害対応・運用の実践トレーニング" },
  { label: "技術研修担当者", detail: "スライドではなく実 AWS で学ぶ研修" },
  { label: "大学・コミュニティ", detail: "準備コストを抑えたハンズオンイベント" },
];

const paths = contactPaths(lang);
---

<BaseLayout
  title="冨田 進 / Susumu Tomita — 合同会社BULL代表・TenkaCloud開発者"
  description="冨田 進（Susumu Tomita）は合同会社 BULL 代表、OSS クラウド競技基盤 TenkaCloud の開発者。実 AWS 環境で学ぶクラウド実戦教育の仕組みを作っています。クラウド基盤・IaC・DevOps・セキュリティ・実践的エンジニアリング教育。"
  lang={lang}
  alternates={portfolioAlternates("")}
  jsonLd={bullGraph(lang, [tenkaCloudSchema(lang)])}
>
  <!-- 1. Hero -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-10">
      <div class="flex-1 space-y-6 min-w-0">
        <p class="text-accent-500 font-medium tracking-wide uppercase text-sm">
          {PROFILE.roleLine}
        </p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
          {PROFILE.displayName}
        </h1>
        <p class="text-xl md:text-2xl text-light-muted dark:text-dark-muted max-w-3xl">
          {PROFILE.tagline[lang]}
        </p>
        <p class="text-light-muted dark:text-dark-muted max-w-3xl">
          {PROFILE.tenkaCloudOneLiner[lang]}
          <span class="block mt-1">専門は{PROFILE.focusLine[lang]}。</span>
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href={bullPath(lang, "/tenkacloud")}
            class="inline-flex items-center px-6 py-3 bg-accent-500 hover:bg-accent-600 text-white font-medium rounded-lg transition-colors"
          >
            TenkaCloud を見る
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center px-6 py-3 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 font-medium rounded-lg transition-colors"
          >
            相談する / Contact
          </a>
          <a
            href={LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 font-medium rounded-lg transition-colors"
          >
            GitHub を見る
          </a>
        </div>
      </div>
      <div class="shrink-0 mx-auto md:mx-0">
        <img
          src={PROFILE.image}
          alt={PROFILE.imageAlt[lang]}
          width="460"
          height="460"
          loading="eager"
          decoding="async"
          class="w-32 h-32 md:w-44 md:h-44 rounded-full border-2 border-light-border dark:border-dark-border object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 2. What I Build -->
  <section
    id="what-i-build"
    class="scroll-mt-20 bg-light-surface dark:bg-dark-surface border-y border-light-border dark:border-dark-border"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">What I Build</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">TenkaCloud</h2>
      <p class="text-light-muted dark:text-dark-muted max-w-3xl mb-8">
        実践的なクラウド研修は、開催のたびに数週間の準備が必要になった時点で続かなくなります。
        TenkaCloud は GameDay 形式の競技を繰り返し開催できる基盤にしたものです。
        マルチテナントのコントロールプレーンが参加者の AWS
        アカウントへ競技環境を自動デプロイし、スライドやシミュレータではなく実際のインフラで学べます。
      </p>
      <div class="grid gap-6 md:grid-cols-2 mb-8">
        <div class="p-6 rounded-lg border border-light-border dark:border-dark-border bg-light-bg dark:bg-dark-bg">
          <h3 class="font-display font-semibold text-lg mb-3">形式と基盤</h3>
          <ul class="space-y-2 text-sm text-light-muted dark:text-dark-muted">
            <li>• <strong>Battle</strong> — チーム対抗のリアルタイム競技</li>
            <li>• <strong>Challenge</strong> — 実 AWS 上での自習型の問題解決</li>
            <li>• 運営コンソール — テナント・ロール・SSO・監査可能性</li>
            <li>• 参加者自身の AWS アカウントへの自動デプロイ</li>
          </ul>
        </div>
        <div class="p-6 rounded-lg border border-light-border dark:border-dark-border bg-light-bg dark:bg-dark-bg">
          <h3 class="font-display font-semibold text-lg mb-3">想定利用者</h3>
          <ul class="space-y-2 text-sm text-light-muted dark:text-dark-muted">
            {tenkaCloudAudience.map((a) => (
              <li>• <strong>{a.label}</strong> — {a.detail}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-sm text-light-muted dark:text-dark-muted max-w-3xl mb-6">
        基盤はオープンソースです。合同会社 BULL
        は、競技の開催支援、問題の作成、社内導入といった商用サポートを提供します。
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href={BULL.tenkacloudSite}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 bg-accent-500 hover:bg-accent-600 text-white text-sm font-medium rounded-lg transition-colors"
        >
          tenkacloud.com
        </a>
        <a
          href={BULL.tenkacloud}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 text-sm font-medium rounded-lg transition-colors"
        >
          GitHub でソースを見る
        </a>
        <a
          href={bullPath(lang, "/tenkacloud")}
          class="inline-flex items-center px-5 py-2.5 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 text-sm font-medium rounded-lg transition-colors"
        >
          詳細・お問い合わせ
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Evidence -->
  <section id="evidence" class="scroll-mt-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">Evidence</p>
    <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">第三者が確認できる実績</h2>
    <p class="text-light-muted dark:text-dark-muted max-w-3xl mb-8">
      自己紹介文ではなく、確認できる証拠を集めています。各項目はカンファレンスのセッションページ、主催者の公式ページ、公開済みの講演資料など、一次情報へリンクしています。
    </p>
    <ul class="grid gap-4 md:grid-cols-2">
      {EVIDENCE.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex h-full flex-col p-5 rounded-lg border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 transition-colors"
          >
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <span class="font-display font-semibold group-hover:text-accent-500 transition-colors">
                {item.event}{item.year && ` ${item.year}`}
              </span>
              <span class="shrink-0 px-2 py-0.5 text-xs font-medium bg-accent-500/10 text-accent-500 rounded-full">
                {item.role[lang]}
              </span>
            </div>
            <p class="text-sm text-light-muted dark:text-dark-muted">{item.title[lang]}</p>
            <p class="mt-auto pt-3 text-xs text-accent-500">{item.source[lang]} →</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4. Selected Outcomes -->
  <section
    id="outcomes"
    class="scroll-mt-20 bg-light-surface dark:bg-dark-surface border-y border-light-border dark:border-dark-border"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">Selected Outcomes</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-8">課題 → 対応 → 結果</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {OUTCOMES.map((o) => (
          <div class="flex h-full flex-col p-6 rounded-lg border border-light-border dark:border-dark-border bg-light-bg dark:bg-dark-bg">
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="font-medium text-light-muted dark:text-dark-muted uppercase text-xs tracking-wide mb-1">課題</dt>
                <dd>{o.challenge[lang]}</dd>
              </div>
              <div>
                <dt class="font-medium text-light-muted dark:text-dark-muted uppercase text-xs tracking-wide mb-1">対応</dt>
                <dd>{o.action[lang]}</dd>
              </div>
              <div>
                <dt class="font-medium text-light-muted dark:text-dark-muted uppercase text-xs tracking-wide mb-1">結果</dt>
                <dd class="font-medium">{o.result[lang]}</dd>
              </div>
            </dl>
            <a
              href={o.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto pt-4 text-sm font-medium text-accent-500 hover:text-accent-600 transition-colors"
            >
              {o.evidenceLabel[lang]} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Selected Experience -->
  <section id="experience" class="scroll-mt-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">Selected Experience</p>
    <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">関わってきた組織</h2>
    <p class="text-light-muted dark:text-dark-muted max-w-3xl mb-8">
      顧客推薦ではなく、雇用・業務委託など関係性を明示した一覧です。詳細は
      <a href={portfolioPath("ja", "/about")} class="text-accent-500 hover:underline">自己紹介</a>と
      <a href={portfolioPath("ja", "/resume")} class="text-accent-500 hover:underline">経歴</a>のページにあります。
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      {EXPERIENCE_GROUPS.map((group) => (
        <div class="p-6 rounded-lg border border-light-border dark:border-dark-border">
          <h3 class="font-display font-semibold text-lg mb-4">{group.label[lang]}</h3>
          <ul class="space-y-3">
            {group.organizations.map((org) => (
              <li class="text-sm">
                <span class="font-medium">{org.name}</span>
                <span class="text-light-muted dark:text-dark-muted"> — {org.detail[lang]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- 6. Speaking & Writing -->
  <section
    id="speaking"
    class="scroll-mt-20 bg-light-surface dark:bg-dark-surface border-y border-light-border dark:border-dark-border"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">Speaking &amp; Writing</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">一貫したテーマ</h2>
      <p class="text-light-muted dark:text-dark-muted max-w-3xl mb-8">
        登壇も執筆も、クラウド基盤・IaC・DevOps・セキュリティ・組織改善という同じテーマを軸にしています。
      </p>
      <div class="grid gap-6 md:grid-cols-3 mb-10">
        {SPEAKING_THEMES.map((t) => (
          <div class="p-5 rounded-lg border border-light-border dark:border-dark-border bg-light-bg dark:bg-dark-bg">
            <h3 class="font-display font-semibold mb-3 text-accent-500">{t.theme[lang]}</h3>
            <ul class="space-y-1 text-sm text-light-muted dark:text-dark-muted">
              {t.events.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-4 mb-4">
        <a
          href={LINKS.speakerdeck}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 text-sm font-medium rounded-lg transition-colors"
        >
          Speaker Deck で資料を見る
        </a>
        <a
          href={LINKS.sessionize}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 text-sm font-medium rounded-lg transition-colors"
        >
          Sessionize プロフィール
        </a>
        <a
          href={LINKS.zenn}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 text-sm font-medium rounded-lg transition-colors"
        >
          Zenn で記事を読む
        </a>
      </div>
      <p class="text-sm text-light-muted dark:text-dark-muted">
        登壇のご依頼は<a href="#contact" class="text-accent-500 hover:underline">お問い合わせ</a>からどうぞ。
      </p>
    </div>
  </section>

  <PublishedBooks />

  <!-- Recent posts -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-display text-2xl md:text-3xl font-bold">最近の記事</h2>
      <a href="/blog" class="text-sm font-medium text-accent-500 hover:text-accent-600 transition-colors">
        すべて見る →
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {recentPosts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block p-6 rounded-lg border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 transition-colors"
        >
          <time class="text-sm text-light-muted dark:text-dark-muted">
            {formatDate(new Date(post.data.pubDate || new Date()))}
          </time>
          <h3 class="mt-2 font-display font-semibold text-lg group-hover:text-accent-500 transition-colors line-clamp-2">
            {post.data.title}
          </h3>
          <p class="mt-2 text-sm text-light-muted dark:text-dark-muted line-clamp-2">
            {post.data.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- 7. About -->
  <section
    id="about"
    class="scroll-mt-20 bg-light-surface dark:bg-dark-surface border-y border-light-border dark:border-dark-border"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">About</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">QA からクラウドへ、そして学びの仕組みづくりへ</h2>
      <p class="text-light-muted dark:text-dark-muted max-w-3xl mb-6">
        ミッションクリティカルなシステムの QA から始まり、コネクテッドサービスのクラウドアーキテクチャと
        SRE を経て、部門を越えてソフトウェアの届け方を改善してきました。品質、インフラ、そして「手を動かして学ぶ」こと。この一本の軸が、合同会社
        BULL の設立と、スライドではなく実 AWS で学ぶ TenkaCloud の開発につながっています。
      </p>
      <a
        href={portfolioPath("ja", "/about")}
        class="text-sm font-medium text-accent-500 hover:text-accent-600 transition-colors"
      >
        詳しい経歴を見る →
      </a>
    </div>
  </section>

  <!-- 8. Contact -->
  <section id="contact" class="scroll-mt-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <p class="text-accent-500 font-medium tracking-wide uppercase text-sm mb-3">Contact</p>
    <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">目的に合わせた窓口</h2>
    <p class="text-light-muted dark:text-dark-muted max-w-3xl mb-8">
      それぞれの窓口から適切なフォーム・ページへつながります。いただいた内容はすべて目を通し、メールで返信します。ニュースレターへの自動登録などは行いません。
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      {paths.map((p) => (
        <a
          href={p.href}
          target={p.external ? "_blank" : undefined}
          rel={p.external ? "noopener noreferrer" : undefined}
          class="group flex h-full flex-col p-6 rounded-lg border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 transition-colors"
        >
          <h3 class="font-display font-semibold text-lg mb-2 group-hover:text-accent-500 transition-colors">
            {p.title[lang]}
          </h3>
          <p class="text-sm text-light-muted dark:text-dark-muted">{p.description[lang]}</p>
          <p class="mt-auto pt-4 text-sm font-medium text-accent-500">{p.cta[lang]} →</p>
        </a>
      ))}
    </div>
    <p class="mt-6 text-sm text-light-muted dark:text-dark-muted">
      全般的なお問い合わせ:
      <a
        href={contactFormUrl || `mailto:${LINKS.email}`}
        target={contactFormUrl ? "_blank" : undefined}
        rel={contactFormUrl ? "noopener noreferrer" : undefined}
        class="text-accent-500 hover:underline"
      >
        {contactFormUrl ? "お問い合わせフォーム" : LINKS.email}
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
