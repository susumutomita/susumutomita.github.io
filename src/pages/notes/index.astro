---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Self-study notes. Each entry is a single self-contained HTML page served from
// public/notes/, synced from susumutomita/advanced-cryptography-note by
// scripts/sync-to-site.sh in that repository (that repository is the source).
const notes = [
  {
    title: "Week 4 — 証明システムを 3 つの部品に分ける",
    description:
      "証明とゼロ知識性。NP・IP・PCP・IOP から、GKR（SumCheck）・STARK（AIR + FRI）・PLONK（KZG + 大積）を算術化・コミットメント・証明システムの 3 部品で並べる。嘘の証明者がすり抜ける確率を数える 3 つのラボつき。",
    href: "/notes/ac2026-week4/",
    week: "Week 4",
    date: "2026-08-18",
  },
  {
    title: "Week 3 — 楕円曲線と Schnorr（講義スライド 65 枚と同じ順番のカード列）",
    description:
      "宿題 schnorr-from-scratch の 10 関数をスライド番号つきで読む。講義が飛ばした「制約 → 多項式 → 短い証明」と「ゼロ知識証明を自分で組み立てる手順」、用語集、simulator と nonce 再利用のラボ、検問クイズ。",
    href: "/notes/ac2026-week3/",
    week: "Week 3",
    date: "2026-08-19",
  },
  {
    title: "Week 2 — 秘密を分けて、集めずに計算する（MPC）",
    description:
      "秘密分散と Beaver 三つ組から、紛失通信（OT）と GMW の AND まで。わざと壊した採点結果の実測、GMW を 1 ステップずつ回せるラボ、開示検問クイズ。",
    href: "/notes/ac2026-week2/",
    week: "Week 2",
    date: "2026-08-12",
  },
  {
    title: "Week 1 — 算術回路の作り方と、壊し方",
    description:
      "なぜ回路で書くのか、なぜプライバシーが守れるのか、なぜ + と × しか使えないのか。制約を 1 本外して回路を壊せる対話ラボと検問クイズ。",
    href: "/notes/ac2026-week1/",
    week: "Week 1",
    date: "2026-08-03",
  },
  {
    title: "Week 0（土台編）— 有限体と楕円曲線",
    description:
      "mod 演算・群環体・逆元・離散対数問題。素数と合成数を切り替えて零因子が現れる／消えるのを見る電卓と、曲線の全点を描いて離散対数を総当たりで解くラボ。",
    href: "/notes/ac2026-week0/",
    week: "Week 0",
    date: "2026-08-13",
  },
];

const formatDate = (dateStr: string) =>
  new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "short", day: "numeric" }).format(
    new Date(dateStr),
  );
---

<BaseLayout
  title="Notes - Susumu Tomita"
  description="zk-tokyo Advanced Cryptography Program 2026 の自習ノート。読むだけで終わらせず、壊して・試して定着させる教材。"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="mb-16">
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-6">Notes</h1>
      <p class="text-lg text-light-muted dark:text-dark-muted max-w-3xl">
        zk-tokyo <a
          href="https://github.com/zk-tokyo/advanced-cryptography-2026"
          class="underline hover:text-accent-500"
          target="_blank"
          rel="noopener noreferrer">Advanced Cryptography Program 2026</a
        > を受講しながら書いている自習ノートです。各週 1 枚の HTML で、外部通信もビルドも要りません。
        前提から書き、壊せるラボと検問クイズで定着させます。ソースは
        <a
          href="https://github.com/susumutomita/advanced-cryptography-note"
          class="underline hover:text-accent-500"
          target="_blank"
          rel="noopener noreferrer">susumutomita/advanced-cryptography-note</a
        >。
      </p>
    </div>

    <section>
      <div class="space-y-6">
        {
          notes.map((note) => (
            <a
              href={note.href}
              class="block p-6 rounded-lg border border-light-border dark:border-dark-border hover:border-accent-500 dark:hover:border-accent-500 transition-colors group"
            >
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2 py-0.5 text-xs font-medium bg-accent-500/10 text-accent-500 rounded">
                  {note.week}
                </span>
                <time class="text-sm text-light-muted dark:text-dark-muted">{formatDate(note.date)}</time>
              </div>
              <h2 class="font-display font-semibold text-xl mb-2 group-hover:text-accent-500 transition-colors">
                {note.title}
              </h2>
              <p class="text-light-muted dark:text-dark-muted">{note.description}</p>
              <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-accent-500">
                ノートを開く
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
